# All integrations are optional. With no keys the app uses heuristic analysis.
# Demo buttons still fetch public websites; they are not offline fixtures.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_CRUX_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=120000

# Optional isolated Browserless service. See SECURITY.md before enabling.
SCREENSHOT_SERVICE_URL=
SCREENSHOT_SERVICE_TOKEN=
SCREENSHOT_TIMEOUT_MS=45000

# Optional feedback delivery; all three values are required. Server-side only.
# The HTTPS endpoint accepts { token, email, subject, message } and must return
# { "status": "success" } after delivery. Use your own service and a NEW token.
FEEDBACK_GAS_URL=
FEEDBACK_GAS_TOKEN=
FEEDBACK_RECIPIENT_EMAIL=

# Optional Google Analytics ID. Public, embedded at BUILD time.
# Leave empty to avoid loading analytics or creating a tracking event queue.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Existing deployments can instead use SEO_OPS_ aliases for OPENAI_API_KEY,
# OPENAI_MODEL, GOOGLE_CRUX_API_KEY, GOOGLE_PAGESPEED_API_KEY,
# PAGESPEED_TIMEOUT_MS, SCREENSHOT_SERVICE_URL, SCREENSHOT_SERVICE_TOKEN,
# and SCREENSHOT_TIMEOUT_MS. Unprefixed variables take precedence.

# Optional private persona library: Supabase Postgres + email Auth.
# Run the migration and configure email redirects; see docs/PERSONAS_SETUP.md.
# Use only a publishable key (or legacy anon key), NEVER a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact public origin, or http://localhost:3000 for local development.
APP_URL=
